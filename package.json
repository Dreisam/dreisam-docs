{
  "name": "dreisam-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:sdk-ol && pnpm run build:sdk",
    "build:sdk": "pnpm --filter @dreisam/sdk-docs run build",
    "build:sdk-ol": "pnpm --filter @dreisam/sdk-ol-docs run build",
    "dev:sdk": "pnpm --filter @dreisam/sdk-docs run dev",
    "dev:sdk-ol": "pnpm --filter @dreisam/sdk-ol-docs run dev"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
